APP_NAME=MINETRACE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PERHATIAN: bila tidak di-set, SESSION_COOKIE / CACHE_PREFIX / REDIS_PREFIX diturunkan dari APP_NAME.
# Mengganti APP_NAME pada instalasi yang sudah berjalan = semua pengguna logout + cache/antrean lama
# tak terbaca. Pin ke nilai lama (mis. SESSION_COOKIE=minetra_session, CACHE_PREFIX=minetra_cache_,
# REDIS_PREFIX=minetra_database_) sebelum mengganti APP_NAME. Lihat docs/minetrace/01_RENAME_INVENTORY.md.
# SESSION_COOKIE=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── CCTV Integration ─────────────────────────────────────────────────────────
# CCTV_USE_REAL=false → gunakan simulasi mediamtx (cam_gate1/cam_wet/cam_warehouse)
# CCTV_USE_REAL=true  → gunakan CCTV fisik TP-Link Tapo C500 (CCTV_RTSP_URL)
#
# PENTING (produksi/VPS): CCTV_RTSP_URL biasanya menunjuk ke IP LAN privat
# (mis. 192.168.x.x) tempat kamera fisik berada. Host app/worker (container
# Docker di VPS) HARUS punya rute jaringan ke IP tersebut sebelum
# CCTV_USE_REAL=true diaktifkan — mis. lewat VPN/tunnel (Tailscale/WireGuard)
# yang menghubungkan LAN kamera ke VPS. Tanpa itu, mengaktifkan flag ini
# hanya membuat live-view dan snapshot RFID gagal terus-menerus (RTSP
# unreachable) tanpa error yang jelas ke pengguna akhir.
CCTV_USE_REAL=false
CCTV_RTSP_URL=rtsp://admin_minetra:password@192.168.0.8/stream2
CCTV_HLS_BASE_URL=http://YOUR_SERVER_IP:8888
CCTV_MEDIAMTX_RTSP=rtsp://mediamtx:8554
CCTV_MEDIAMTX_API=http://mediamtx:9997
CCTV_FFMPEG_TIMEOUT=30
CCTV_QUEUE=default

# ─── RFID Hardware ────────────────────────────────────────────────────────────
# Token opsional untuk validasi request ESP32 (kosong = open mode).
RFID_API_TOKEN=
# Kode company (kolom `code` di tabel companies) yang dipakai sebagai fallback
# tenant saat request /api/rfid/* tidak menyertakan header X-Company-Code
# (mis. ESP32 firmware lama, atau panggilan tanpa header sama sekali).
# WAJIB diisi sesuai deployment — JANGAN diasumsikan selalu company_id=1,
# karena company_id=1 bisa saja bukan perusahaan operasional (mis. regulator).
RFID_DEFAULT_COMPANY_CODE=TIMAH

# ─── RFID UHF ────────────────────────────────────────────────────────────────
# Setiap pembacaan tercatat di rfid_read_logs. Capture CCTV untuk pembacaan yang
# DITOLAK (mis. tag asing di gate) dan untuk registrasi tag di Receiving Area.
RFID_CAPTURE_ON_REJECT=true
RFID_CAPTURE_ON_REGISTER=true
# Gate Chainway UR4 (daemon `php artisan rfid:uhf-gate`): port TCP default reader,
# jeda kehadiran tag (detik), RSSI minimum (dBm, kosong = tanpa filter), jeda sambung ulang maks.
RFID_UR4_PORT=8888
RFID_UHF_PRESENCE_SECONDS=10
RFID_UHF_MIN_RSSI=
RFID_UHF_RECONNECT_MAX=30
# Reader UHF desktop R2000 (USB, Web Serial di browser Receiving): baud rate.
RFID_UHF_DESKTOP_BAUD=9600

# ─── Sanctum (API token auth untuk mobile/API client) ─────────────────────────
# Domain yang boleh menerima cookie autentikasi stateful SPA. WAJIB memuat
# domain frontend Anda (localhost untuk dev, domain produksi untuk live).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1
