APP_NAME='MINETRACE Local'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database — Docker local ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=minetra_local
DB_USERNAME=minetra
DB_PASSWORD=minetra_local_pass

# ── Cache & Queue — Docker Redis ──────────────────────────────────────────────
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ── Redis — Docker local ───────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── CCTV — MediaMTX Docker local ──────────────────────────────────────────────
# cam_gate1 = simulation stream (test pattern + real-time clock)
# Set CCTV_USE_REAL=true jika CCTV fisik tersedia di LAN yang sama
CCTV_RTSP_URL=rtsp://127.0.0.1:8554/cam_gate1
CCTV_HLS_BASE_URL=http://localhost:8888
CCTV_MEDIAMTX_RTSP=rtsp://127.0.0.1:8554
CCTV_MEDIAMTX_API=http://localhost:9997
CCTV_FFMPEG_TIMEOUT=30
CCTV_QUEUE=default
CCTV_USE_REAL=false

# ── RFID — open mode (no token required for local dev) ───────────────────────
RFID_API_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,localhost

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
